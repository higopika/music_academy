# Modern Python 3.11 with FastAPI
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    nmap \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi>=0.100.0 \
    uvicorn[standard] \
    gunicorn \
    mysql-connector-python \
    sqlalchemy \
    pandas \
    openpyxl \
    xlrd>=2.0.1 \
    python-multipart \
    openai \
    httpx

# Create app directory
WORKDIR /app

# Copy application files
COPY backend/app/main.py /app/
COPY backend/app/crud.py /app/
COPY backend/app/database.py /app/
COPY backend/app/models.py /app/
COPY backend/app/schemas.py /app/
COPY backend/app/utils.py /app/
COPY backend/app/chatbot_service.py /app/

# Copy service check script
COPY tools/check_service.sh /check_service.sh
RUN chmod +x /check_service.sh

# Expose port
EXPOSE 80

# Start command - wait for MySQL then start FastAPI
CMD /check_service.sh shrine_mysql 3306; uvicorn main:app --host 0.0.0.0 --port 80





